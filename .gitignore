# Zig
.zig-cache/
zig-out/

# Local tools (cmake, ninja, venv)
.tools/

# Downloaded dependencies (fetched with libs/bootstrap.sh)
libs/dawn/
libs/glfw/
# Box2D is built from source by libs/bootstrap.sh; the pin lives in
# libs/box2d.commit, which IS tracked, and the 6.5 MB of build output is not.
libs/box2d/
# Dear ImGui (Docking) and the editor's typefaces: the pins live in
# libs/imgui.commit and libs/fonts.commit, which ARE tracked.
libs/imgui/
libs/fonts/
# Dawn's generated C headers are not installed by the bootstrap, but the
# repository checkout carries them: imgui's WebGPU backend includes
# <webgpu/webgpu.h> and links the SAME Dawn we already build.


# Logs and development artifacts
*.log

# Bench output (the sample lives in samples/scene.zson)
/scene.zson

# The editor's per-scene bookkeeping: the prefab overrides sidecar and the
# crash-recovery copy. Both are DERIVED from the scene — they record what the
# user changed on top of it, and what was unsaved when the editor died — and
# neither belongs in the repository.
*.overrides
*.autosave
*.autosave.tmp
