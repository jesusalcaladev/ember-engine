project "First Game"
version "0.1.0"

application {
  name "First Game"
}

display {
  width 1280
  height 720
  vsync true
}

scripts {
  behavior "scripts/player.lua" "scripts/coin.lua"
  global "scripts/globals/flow.lua"
}

input_map {
  move_left ["KEY_A", "KEY_LEFT"]
  move_right ["KEY_D", "KEY_RIGHT"]
  move_up ["KEY_W", "KEY_UP"]
  move_down ["KEY_S", "KEY_DOWN"]
  pause ["KEY_ESCAPE"]
}
