project "MyGame"
version "0.1.0"

application {
  name "My Game"
  icon "assets/icon.png"
  splash_screen {
    image "assets/splash.png"
    duration 2.5
    background_color "#1a1a2e"
  }
}

display {
  width 1280
  height 720
  vsync true
  fullscreen false
  resizable true
  max_fps 60
}

rendering {
  antialiasing "smaa"
  sort_mode "front_to_back"
  max_sprites 100000
}

lighting {
  shadow_resolution 1024
}

physics {
  gravity 9.8
  solver_iterations 4
  time_before_sleep 0.5
  max_physics_steps_per_frame 4
  sleep_threshold_linear 8.0
  sleep_threshold_angular 8.0
}

layers {
  names "world" "player" "enemy" "projectile" "pickup"
  default_mask "world"
}

audio {
  enabled true
  backend "miniaudio"
  sample_rate "48000"
  period_frames 480
  voices 128
  budget_bytes 16777216
  master_volume 0.8
  buses "master" "music" "sfx" "ui"
}

input_map {
  move_left ["KEY_A", "KEY_LEFT"]
  move_right ["KEY_D", "KEY_RIGHT"]
  jump ["KEY_SPACE"]
  pause ["KEY_ESCAPE"]
  action ["KEY_E"]
  attack ["KEY_J", "JOY_A"]
}
